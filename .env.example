# Database
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5432/solarsync

# JWT Auth
SECRET_KEY=change-this-to-a-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# App
APP_NAME=SolarSync
BASE_URL=http://127.0.0.1:8000
DEBUG=true

# AI (Phase 2)
# GEMINI_API_KEY=your-key-here

# File uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10
